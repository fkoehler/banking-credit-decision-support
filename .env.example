# Copy only the values you need to override into .envrc.local.
AUTH_MODE=local
DATABASE_URL=postgresql://user@127.0.0.1:5432/bank_credit_support
JDBC_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/bank_credit_support
AI_INFERENCE_PROVIDER=local
AI_EMBEDDING_PROVIDER=local
AI_GENERATION_PROVIDER=template
AI_VECTOR_STORE=postgres

# Optional cloud profile. Never commit real values.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_ML_ENDPOINT=
AZURE_ML_API_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
