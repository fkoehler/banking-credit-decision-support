#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="$ROOT_DIR/.run"
LOG_DIR="$RUN_DIR/logs"

required_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    return 1
  fi
}

doctor() {
  local failed=0
  for command_name in java direnv uv node pnpm psql pg_isready createdb; do
    required_command "$command_name" || failed=1
  done

  if command -v java >/dev/null 2>&1 && ! java -version 2>&1 | head -n 1 | grep -q '"21\.'; then
    echo "Java 21 is required. Run: sdk env install && sdk env" >&2
    failed=1
  fi

  if command -v pg_config >/dev/null 2>&1; then
    local control_file
    control_file="$(pg_config --sharedir)/extension/vector.control"
    if [[ ! -f "$control_file" ]]; then
      echo "PostgreSQL is installed, but pgvector is missing ($control_file)." >&2
      echo "On macOS install a matching PostgreSQL and pgvector package, then rerun ./dev doctor." >&2
      failed=1
    fi
  fi

  if [[ "$failed" -ne 0 ]]; then
    exit 1
  fi
  echo "Local toolchain is ready."
}

bootstrap() {
  doctor
  uv sync --project "$ROOT_DIR/services/ai-service"
  pnpm --dir "$ROOT_DIR/services/web-ui" install --frozen-lockfile=false
  "$ROOT_DIR/mvnw" -q -f "$ROOT_DIR/pom.xml" -DskipTests package

  if ! pg_isready -h "${DATABASE_HOST:-127.0.0.1}" -p "${DATABASE_PORT:-5432}" >/dev/null 2>&1; then
    echo "PostgreSQL is not running. Start your local PostgreSQL service first." >&2
    exit 1
  fi
  if ! psql -h "${DATABASE_HOST:-127.0.0.1}" -p "${DATABASE_PORT:-5432}" -d postgres -Atqc \
    "SELECT 1 FROM pg_database WHERE datname='${DATABASE_NAME:-bank_credit_support}'" | grep -q 1; then
    createdb -h "${DATABASE_HOST:-127.0.0.1}" -p "${DATABASE_PORT:-5432}" "${DATABASE_NAME:-bank_credit_support}"
  fi
  psql "${DATABASE_URL:-postgresql://${USER}@127.0.0.1:5432/bank_credit_support}" -v ON_ERROR_STOP=1 \
    -c "CREATE EXTENSION IF NOT EXISTS vector"
  uv run --project "$ROOT_DIR/services/ai-service" python -m bank_ai.train
  echo "Bootstrap complete. Run ./dev up."
}

start_process() {
  local name="$1"
  shift
  "$@" >"$LOG_DIR/$name.log" 2>&1 &
  echo $! >"$RUN_DIR/$name.pid"
  echo "Started $name (pid $!, log $LOG_DIR/$name.log)"
}

up() {
  mkdir -p "$LOG_DIR"
  if [[ -f "$RUN_DIR/api.pid" ]]; then
    echo "Project processes appear to be running. Use ./dev down first." >&2
    exit 1
  fi
  start_process ai uv run --project "$ROOT_DIR/services/ai-service" uvicorn bank_ai.main:app \
    --app-dir "$ROOT_DIR/services/ai-service/src" --host "${AI_HOST:-127.0.0.1}" --port "${AI_PORT:-8081}"
  start_process api "$ROOT_DIR/mvnw" -q -f "$ROOT_DIR/services/banking-api/pom.xml" spring-boot:run
  start_process web pnpm --dir "$ROOT_DIR/services/web-ui" dev --host "${WEB_HOST:-127.0.0.1}" --port "${WEB_PORT:-5173}"
  echo "Services are starting. Follow logs with: tail -f $LOG_DIR/*.log"
  echo "Web UI: http://${WEB_HOST:-127.0.0.1}:${WEB_PORT:-5173}"
}

down() {
  for name in web api ai; do
    local pid_file="$RUN_DIR/$name.pid"
    if [[ -f "$pid_file" ]]; then
      local pid
      pid="$(<"$pid_file")"
      if kill -0 "$pid" >/dev/null 2>&1; then
        kill "$pid"
        echo "Stopped $name (pid $pid)"
      fi
      rm -f "$pid_file"
    fi
  done
}

seed() {
  uv run --project "$ROOT_DIR/services/ai-service" python -m bank_ai.seed
  curl --fail --silent --show-error \
    -u "${LOCAL_ADVISOR_USERNAME:-advisor}:${LOCAL_ADVISOR_PASSWORD:-advisor-demo}" \
    -H 'Content-Type: application/json' \
    -d '{"profession":"DENTIST","annualIncome":185000,"practiceRevenue":620000,"practiceAgeYears":4,"existingDebt":80000,"requestedCredit":450000,"equity":100000,"latePayments":0}' \
    "http://${API_HOST:-127.0.0.1}:${API_PORT:-8080}/api/v1/cases"
  echo
}

test_all() {
  "$ROOT_DIR/mvnw" -f "$ROOT_DIR/pom.xml" test
  "$ROOT_DIR/services/ai-service/.venv/bin/ruff" check \
    "$ROOT_DIR/services/ai-service/src" "$ROOT_DIR/services/ai-service/tests"
  "$ROOT_DIR/services/ai-service/.venv/bin/pytest" "$ROOT_DIR/services/ai-service/tests"
  pnpm --dir "$ROOT_DIR/services/web-ui" test --run
  terraform -chdir="$ROOT_DIR/infrastructure/terraform" fmt -check
  terraform -chdir="$ROOT_DIR/infrastructure/terraform" validate
}

case "${1:-}" in
  doctor) doctor ;;
  bootstrap) bootstrap ;;
  up) up ;;
  down) down ;;
  seed) seed ;;
  test) test_all ;;
  *) echo "Usage: ./dev {doctor|bootstrap|up|down|seed|test}" >&2; exit 2 ;;
esac
