# Safe, non-secret defaults for the local demo. Put personal overrides in
# .envrc.local, which is deliberately ignored by Git.
if [[ -s "${SDKMAN_DIR:-$HOME/.sdkman}/bin/sdkman-init.sh" ]]; then
  source "${SDKMAN_DIR:-$HOME/.sdkman}/bin/sdkman-init.sh"
  sdk env
fi

export APP_ENV="${APP_ENV:-local}"
export API_HOST="${API_HOST:-127.0.0.1}"
export API_PORT="${API_PORT:-8080}"
export AI_HOST="${AI_HOST:-127.0.0.1}"
export AI_PORT="${AI_PORT:-8081}"
export WEB_HOST="${WEB_HOST:-127.0.0.1}"
export WEB_PORT="${WEB_PORT:-5173}"

export DATABASE_NAME="${DATABASE_NAME:-bank_credit_support}"
export DATABASE_HOST="${DATABASE_HOST:-127.0.0.1}"
export DATABASE_PORT="${DATABASE_PORT:-5432}"
export DATABASE_USER="${DATABASE_USER:-$USER}"
export DATABASE_PASSWORD="${DATABASE_PASSWORD:-}"
export DATABASE_URL="${DATABASE_URL:-postgresql://${DATABASE_USER}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}}"
export JDBC_DATABASE_URL="${JDBC_DATABASE_URL:-jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}}"

export AUTH_MODE="${AUTH_MODE:-local}"
export LOCAL_ADVISOR_USERNAME="${LOCAL_ADVISOR_USERNAME:-advisor}"
export LOCAL_ADVISOR_PASSWORD="${LOCAL_ADVISOR_PASSWORD:-advisor-demo}"
export LOCAL_REVIEWER_USERNAME="${LOCAL_REVIEWER_USERNAME:-reviewer}"
export LOCAL_REVIEWER_PASSWORD="${LOCAL_REVIEWER_PASSWORD:-reviewer-demo}"

export AI_SERVICE_URL="${AI_SERVICE_URL:-http://${AI_HOST}:${AI_PORT}}"
export AI_MODEL_PATH="${AI_MODEL_PATH:-$PWD/services/ai-service/artifacts/risk-model.joblib}"
export AI_MODEL_METADATA_PATH="${AI_MODEL_METADATA_PATH:-$PWD/services/ai-service/artifacts/metrics.json}"
export AI_INFERENCE_PROVIDER="${AI_INFERENCE_PROVIDER:-local}"
export AI_EMBEDDING_PROVIDER="${AI_EMBEDDING_PROVIDER:-local}"
export AI_GENERATION_PROVIDER="${AI_GENERATION_PROVIDER:-template}"
export AI_VECTOR_STORE="${AI_VECTOR_STORE:-postgres}"
export AI_LOCAL_EMBEDDING_MODEL="${AI_LOCAL_EMBEDDING_MODEL:-intfloat/multilingual-e5-small}"
export AI_EMBEDDING_DIMENSIONS="${AI_EMBEDDING_DIMENSIONS:-384}"
export AI_CHUNK_SIZE="${AI_CHUNK_SIZE:-700}"
export AI_CHUNK_OVERLAP="${AI_CHUNK_OVERLAP:-100}"
export AI_RAG_TOP_K="${AI_RAG_TOP_K:-5}"

export AZURE_OPENAI_ENDPOINT="${AZURE_OPENAI_ENDPOINT:-}"
export AZURE_OPENAI_API_KEY="${AZURE_OPENAI_API_KEY:-}"
export AZURE_OPENAI_API_VERSION="${AZURE_OPENAI_API_VERSION:-}"
export AZURE_OPENAI_CHAT_DEPLOYMENT="${AZURE_OPENAI_CHAT_DEPLOYMENT:-}"
export AZURE_OPENAI_EMBEDDING_DEPLOYMENT="${AZURE_OPENAI_EMBEDDING_DEPLOYMENT:-}"
export AZURE_ML_ENDPOINT="${AZURE_ML_ENDPOINT:-}"
export AZURE_ML_API_KEY="${AZURE_ML_API_KEY:-}"
export AZURE_TENANT_ID="${AZURE_TENANT_ID:-}"
export AZURE_CLIENT_ID="${AZURE_CLIENT_ID:-}"

export VITE_API_URL="${VITE_API_URL:-http://${API_HOST}:${API_PORT}}"

if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi
